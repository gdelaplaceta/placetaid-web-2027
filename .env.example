SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Local fallback only; configure the same variables in the deployment provider.
PLID27_ENV_FILE=../rsp-web/server/.env
PLACETAID_V27_ADMIN_KEY=
PLID27_SESSION_SECRET=
PLID27_ENCRYPTION_KEY=
# Must match PLACETAID_V27_DEVICE_KEY in the verified legacy device-registration server.
PLACETAID_V27_DEVICE_KEY=
# Temporary fallback; set to false to disable password-based gateway login.
PLACETAID_V27_PASSWORD_LOGIN_ENABLED=true
API_PORT=4174
NODE_ENV=development